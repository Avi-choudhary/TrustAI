# =================================================================
# TrustAI Backend — Environment Variables (.env.example)
# Copy to .env for local development or configure in Render Dashboard.
# =================================================================

# Server & Network
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://trustai.vercel.app"]

# Database (SQLite default for local, PostgreSQL URL on Render)
DATABASE_URL=sqlite:///./trustai.db
# Example Render PostgreSQL:
# DATABASE_URL=postgresql://user:password@hostname/dbname

# JWT Authentication & Security
JWT_SECRET_KEY=change-this-to-a-secure-random-32-character-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# X402 Payment Protocol Configuration (Web3 / Crypto Micropayments)
X402_MERCHANT_ADDRESS=0x71C8366420A0926793fe14b17bEE06941866420A
X402_FACILITATOR_URL=https://facilitator.x402.org
X402_DEFAULT_NETWORK=eip155:8453
X402_USDC_PRICE_PREMIUM=4.99
X402_USDC_PRICE_SCAN=0.10

# Razorpay Gateway (Optional: For Fiat Card/UPI payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Gemini Vision Forensics (Optional: Visual artifact inspection)
GEMINI_API_KEY=

# Sightengine API (Optional: Layer 4 cloud deepfake detection)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
