# =================================================================
# TrustAI Monorepo — Git Ignore
# =================================================================

# Node dependencies and build artifacts
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
*/dist/
build/
*/build/

# Python environments and byte code caches
.venv/
venv/
.venv_trustai/
*/.venv/
*/venv/
*/.venv_trustai/
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local Environment variables and secrets (Never commit .env files)
.env
.env.*
*.env
!.env.example
!*/.env.example

# Local SQLite databases and runtime storage
*.db
*.sqlite
*.sqlite3
trustai-backend/storage/uploads/*
!trustai-backend/storage/uploads/.gitkeep
trustai-backend/storage/ledger.json

# Local application logs
*.log
*/backend-dev.log
*/backend-dev-error.log

# Vercel & cloud deployment caches
.vercel/
*/.vercel/

# Extension archives
*.zip
*.crx
*.pem
trustai-extension/trustai-extension/

# IDE, Editor, and OS system files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
